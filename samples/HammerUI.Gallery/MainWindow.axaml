<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="https://github.com/runesmithhub/hammerui"
        xmlns:dock="using:HammerUI.Docking"
        x:Class="HammerUI.Gallery.MainWindow"
        Title="HammerUI Gallery"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <ui:DialogHost x:Name="Dialogs">
    <Panel>
      <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource BackgroundBrush}">
        <Border Grid.Row="0" Classes="toolbar appbar" Height="44" Padding="8,0">
          <ui:AppBarPanel>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="2,0,8,0">
                <Border Width="22" Height="22" CornerRadius="6">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Offset="0" Color="#8B8EFA" />
                      <GradientStop Offset="1" Color="#5B4FE0" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <ui:SymbolIcon Data="{x:Static ui:Icons.Hammer}" Size="13" StrokeThickness="2.25" Foreground="White" />
                </Border>
                <TextBlock Text="HammerUI" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Gallery" Classes="muted" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Accent" Classes="muted" VerticalAlignment="Center" />
                <ui:ColorPickerButton x:Name="AccentPicker" Width="120" ToolTip.Tip="The accent color of both themes" />
                <Border Classes="divider-v" Height="18" Margin="6,0" />
                <Button x:Name="ResetLayout" Classes="subtle small" Content="Reset layout" ToolTip.Tip="Put every panel back where it started" />
                <Button x:Name="ThemeToggle" Classes="icon" ToolTip.Tip="Toggle light and dark">
                  <ui:SymbolIcon x:Name="ThemeIcon" />
                </Button>
              </StackPanel>
            </Grid>
          </ui:AppBarPanel>
        </Border>

        <dock:DockHost x:Name="Workspace" Grid.Row="1" />

        <Border Grid.Row="2" Classes="statusbar" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ui:SymbolIcon Classes="status" Data="{x:Static ui:Icons.Info}" />
            <TextBlock Classes="status" Text="Drag a tab onto another group, against an edge or out of the window. Double-click a tab strip to maximize its group." />
          </StackPanel>
        </Border>
      </Grid>
      <ui:ToastHost x:Name="Toasts" />
    </Panel>
  </ui:DialogHost>
</Window>
